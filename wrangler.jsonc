{
  "name": "acropolis-real-estate",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables set in the dashboard (CONTACT_TO, CONTACT_FROM) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
