{
  "name": "acropolis-real-estate",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  // Builds the static site (Vite + prerender) into dist/public before each deploy.
  "build": {
    "command": "pnpm install --frozen-lockfile && pnpm run build"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_FROM": "Acropolis Real Estate <contact888@acropolis-real-estate.com>"
  },
  // Keep variables set in the dashboard (CONTACT_TO) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
