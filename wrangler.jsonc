{
  "name": "acropolis-real-estate",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_FROM": "Acropolis Real Estate <contact@acropolis-real-estate.com>"
  },
  // Keep variables set in the dashboard (CONTACT_TO) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
